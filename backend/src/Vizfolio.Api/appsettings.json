{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=vizfolio.db"
  },
  "Extracts": {
    "Sources": {
      "Securities": {
        "TarballUrl": "https://codeload.github.com/vizfolio/securities-extracts/tar.gz/refs/heads/main"
      },
      "Funds": {
        "--Mode": "Tarball",
        "Mode": "PerFile",
        "TarballUrl": "https://codeload.github.com/vizfolio/fund-extracts/tar.gz/refs/heads/master",
        "ManifestUrl": "https://raw.githubusercontent.com/vizfolio/fund-extracts/refs/heads/master/funds.json",
        "SnapshotUrlTemplate": "https://raw.githubusercontent.com/vizfolio/fund-extracts/refs/heads/master/snapshots/{seriesId}/{period}.json.gz",
        "RequestsPerSecond": 5
      }
    },
    "Schedule": {
      "Enabled": true,
      "RunOnStartup": false,
      "Interval": "06:00:00",
      "StartupDelay": "00:00:30"
    }
  },
  "PriceHistory": {
    "Providers": {
      "Stooq": {
        "Enabled": true,
        "BaseUrl": "https://stooq.com/q/d/l/",
        "RequestsPerSecond": 5
      },
      "Eodhd": {
        "ApiKey": "",
        "BaseUrl": "https://eodhd.com/api",
        "RequestsPerSecond": 5
      },
      "AlphaVantage": {
        "ApiKey": "",
        "BaseUrl": "https://www.alphavantage.co/query",
        "RequestsPerSecond": 5
      }
    },
    "Schedule": {
      "Enabled": true,
      "RunOnStartup": false,
      "Interval": "24:00:00",
      "StartupDelay": "00:01:00"
    }
  }
}
